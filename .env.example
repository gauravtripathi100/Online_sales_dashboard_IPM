# Postgres connection string.
# - Vercel Postgres: copy the "POSTGRES_URL" value it gives you when you create the database.
# - Neon / Supabase / RDS / any other Postgres: use their connection string directly.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Random long string used to sign login sessions. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=replace-this-with-a-long-random-string

# One-time secret used only to create your FIRST admin account via POST /api/setup.
# Pick any long random value. You can leave it set — /api/setup refuses to run
# again once any user already exists — but rotating/removing it afterwards is fine too.
SETUP_SECRET=replace-this-with-another-long-random-string
